<aura:component implements="forceCommunity:themeLayout">
    <!--Custom Regions-->
    <aura:attribute name="hiddenRegion" type="Aura.Component[]" description="Custom region for system/service components" />
    <!--Attributes-->
    <aura:attribute name="menuApiName" type="String" required="true" />
    <!--Main Content Area-->
    <div class="minlopro-container slds-container_x-large slds-container_center slds-card slds-grid slds-grid_vertical">
        <div class="slds-shrink-none">
            <c:digExNavigationBar menuApiName="{!v.menuApiName}" />
        </div>
        <lightning:layout
            multipleRows="true"
            pullToBoundary="small"
            class="slds-grow slds-p-horizontal_medium slds-p-vertical_medium"
        >
            <lightning:layoutItem size="12" largeDeviceSize="9" padding="around-small">
                <div
                    class="slds-p-around_medium minlopro-bg minlopro-hero slds-grid slds-grid_align-center slds-grid_vertical-align-center"
                    style="{!'background-image: url(' + $Resource.CommonsAssets + '/wallpapers/slds-v2-bg-1.jpg' + ');'}"
                >
                    <div class="minlopro-hero-scrim slds-p-around_medium slds-text-align_center">
                        <p class="slds-text-heading_medium slds-text-color_inverse minlopro-hero-title">Welcome to Minlopro DX</p>
                        <p class="slds-text-body_regular slds-text-color_inverse">
                            A hands-on Salesforce DX playground for learning enterprise patterns
                        </p>
                    </div>
                </div>
                <div class="slds-m-vertical_medium slds-theme_shade">{!v.body}</div>
                <div
                    class="slds-p-around_medium minlopro-bg"
                    style="{!'background-image: url(' + $Resource.CommonsAssets + '/wallpapers/slds-v2-bg-2.jpg' + ');'}"
                ></div>
            </lightning:layoutItem>
            <lightning:layoutItem size="12" largeDeviceSize="3" padding="around-small">
                <c:digExRunningUserInfo collapsed="{!true}" />
                <div class="slds-m-vertical_small">{!v.hiddenRegion}</div>
            </lightning:layoutItem>
        </lightning:layout>
        <footer
            class="minlopro-footer slds-theme_inverse slds-p-vertical_large slds-p-horizontal_medium slds-shrink-none slds-grid slds-grid_align-center"
        >
            <div class="slds-media slds-media_center">
                <div class="slds-media__figure">
                    <img src="{!$Resource.MinloproAppLogo}" alt="Minlopro DX logo" class="minlopro-footer-logo" />
                </div>
                <div class="slds-media__body slds-text-align_left">
                    <p class="slds-text-body_regular">
                        A Salesforce DX blueprint project for learning and demonstration purposes.
                    </p>
                    <p class="slds-text-body_small">
                        &#169; 2026 Minlopro DX &mdash; Educational project, not affiliated with Salesforce.
                    </p>
                </div>
            </div>
        </footer>
    </div>
</aura:component>
