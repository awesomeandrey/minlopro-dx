    <description>Phone-only, two-screen SMS inbox POC.</description>
    <isExposed>true</isExposed>
    <masterLabel>Mobile SMS Hub</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
