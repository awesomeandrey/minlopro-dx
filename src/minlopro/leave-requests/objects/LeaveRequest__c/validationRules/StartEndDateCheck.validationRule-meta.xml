<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>StartEndDateCheck</fullName>
    <active>true</active>
    <description>Check start/end dates validity.</description>
    <errorConditionFormula>EndDate__c &lt;  StartDate__c</errorConditionFormula>
    <errorDisplayField>EndDate__c</errorDisplayField>
    <errorMessage>End date must be future date relatively to start date.</errorMessage>
</ValidationRule>
